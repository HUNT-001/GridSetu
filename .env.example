# Copy to .env and fill in what you have. Nothing here is required: with no key and no
# Ollama the copilot falls back to its offline, rule-based assistant.

# Which copilot provider to use: auto | claude | openai | ollama | offline
# auto = Claude if its key is set, else an OpenAI-compatible key, else Ollama, else offline
GRIDSETU_COPILOT=auto

# --- Claude (Anthropic API)
# ANTHROPIC_API_KEY=
# GRIDSETU_MODEL=claude-sonnet-5

# --- Free or cheap OpenAI-compatible APIs: set ONE of these keys
# GROQ_API_KEY=            # console.groq.com, free tier
# GEMINI_API_KEY=          # aistudio.google.com, free tier
# OPENROUTER_API_KEY=      # openrouter.ai, models ending in :free
# GRIDSETU_LLM_MODEL=      # override the default model if the provider retires it

# --- Any other OpenAI-compatible server (vLLM, LM Studio, a hosted endpoint)
# GRIDSETU_LLM_BASE_URL=http://127.0.0.1:1234/v1
# GRIDSETU_LLM_API_KEY=
# GRIDSETU_LLM_MODEL=

# --- Ollama (local, no key)
# OLLAMA_HOST=http://127.0.0.1:11434
# GRIDSETU_OLLAMA_MODEL=qwen2.5:7b-instruct
